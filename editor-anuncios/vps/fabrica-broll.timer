[Unit]
Description=Fabrica de ofertas: mira cada hora si hay una oferta nueva (a los :10, hora de Bogota; cada vuelta le cuesta al dash 3 listados de KV de los 1.000 al dia de toda la suite; el b-roll semanal corre el domingo a las 5:15 y el radar a las 03, 07, 11, 15, 19 y 23)

[Timer]
OnCalendar=*-*-* *:10:00 America/Bogota
# Si el servidor estaba apagado a esa hora, corre al volver a encender
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
